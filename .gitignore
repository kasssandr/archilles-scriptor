__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.audit.txt
!tests/fixtures/**/*.audit.txt
!examples/**/*.audit.txt
# local PoC scratch
scratch/
tmp/
# subagent-driven-development scratch (briefs, reports, ledger, diffs)
.superpowers/
# local test corpora (large IA ZIPs / extracted book dirs)
Test-ZIPs/
corpora/

# local working documents — keep out of the public repo: concept notes, design
# specs, plans, ad-hoc analysis scripts, converted volumes. Real code is in src/.
/*.py
/*.md
!/README.md
docs/superpowers/
docs/internal/
vision_translate/

# evaluation: local (copyrighted) golden volumes and captured outputs stay out
eval/golden-local/
eval/outputs/
eval/excite/
eval/BENCHMARK-draft.md

# benchmark corpus: the metadata and the truth are committed, the material is
# not -- source.json carries URL and checksum so the PDF can be fetched again,
# and page images are derived data that would only bloat the history.
eval/corpus/*/source.pdf
eval/corpus/*/pages/
# Any PDF dropped straight into the corpus directory, before it has been given
# a band directory of its own. Some of this material is in copyright and only
# ever local; the repository is public, so the default here is "out".
eval/corpus/*.pdf
